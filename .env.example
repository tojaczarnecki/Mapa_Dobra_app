# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Application URL and public data policy
APP_BASE_URL="https://your-domain.example"
PUBLIC_DATA_MODE="production"

# Local/manual administrator creation only; never seed automatically in production
ADMIN_SEED_EMAIL="admin@example.org"
ADMIN_SEED_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"
ADMIN_SEED_DISPLAY_NAME="Local administrator"

# Geocoding (admin-only, on demand)
GEOCODER_USER_AGENT="MapaDobraAdmin/1.0"
GEOCODER_CONTACT_EMAIL="admin@example.org"

# Rate limiting and proxy trust
# Local development may use memory. Production requires the future Upstash adapter.
RATE_LIMIT_MODE="upstash"
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_SECRET"
TRUSTED_PROXY_MODE="none"
