# Database
NODE_ENV="production"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Isolated destructive-test database; never point this at production.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST:5432/DATABASE_test?schema=test"
TEST_BASE_DATABASE_URL="postgresql://USER:PASSWORD@BASE_HOST:5432/DATABASE?schema=public"
# Manual production transfer target only; never replace DATABASE_URL with this value.
TARGET_DATABASE_URL="postgresql://USER:PASSWORD@NEON_HOST/DATABASE?sslmode=require"
# Optional direct Neon connection for Prisma CLI/migrations from a trusted machine.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?schema=public"

# Application URL and public data policy
APP_BASE_URL="https://your-domain.example"
# Optional compatibility fallback used only when APP_BASE_URL is absent.
# NEXT_PUBLIC_APP_URL="https://your-domain.example"
# Optional password-reset mail adapter. The endpoint must accept the documented JSON payload.
# ADMIN_RESET_MAIL_URL="https://mail-adapter.example/admin-reset"
# ADMIN_RESET_MAIL_TOKEN="CHANGE_ME"
PUBLIC_DATA_MODE="production"
# Optional explicit deployment target. Omit for normal production; use staging only with RATE_LIMIT_MODE=memory.
DEPLOYMENT_ENV="production"

# Local/manual administrator creation only; never seed automatically in production
ADMIN_SEED_EMAIL="admin@example.org"
ADMIN_SEED_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"
ADMIN_SEED_DISPLAY_NAME="Local administrator"

# Geocoding (admin-only, on demand)
GEOCODER_USER_AGENT="MapaDobraAdmin/1.0"
GEOCODER_CONTACT_EMAIL="admin@example.org"

# Rate limiting and proxy trust
# Local development uses memory. Production requires Upstash; staging may explicitly use memory.
RATE_LIMIT_MODE="upstash"
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_WITH_SECRET"
TRUSTED_PROXY_MODE="none"

# Optional Web Push (generate with `npx web-push generate-vapid-keys`)
# Keep the private key server-side and never expose it to the browser.
VAPID_SUBJECT="mailto:admin@your-domain.example"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Secret for the external scheduler that calls the operator reminder endpoint.
OPERATOR_REMINDER_CRON_SECRET=""

# Optional risk-based anti-bot protection. Keep disabled locally; production may require it.
TURNSTILE_MODE="disabled"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_MODE="disabled"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
