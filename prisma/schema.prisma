model AdminUser {
  id                            String                             @id @default(uuid()) @db.Uuid
  email                         String                             @unique @db.VarChar(320)
  passwordHash                  String?                            @db.VarChar(512)
  displayName                   String                             @db.VarChar(160)
  role                          AdminRole                          @default(MODERATOR)
  active                        Boolean                            @default(true)
  createdAt                     DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                           @updatedAt @db.Timestamptz(3)
  lastLoginAt                   DateTime?                          @db.Timestamptz(3)
  sessions                      AdminSession[]
  auditLogs                     AuditLog[]
  moderatedPlaceUpdates         PlaceUpdateSubmission[]            @relation("PlaceUpdateModerator")
  moderatedNewPlaceSubmissions  NewPlaceSubmission[]               @relation("NewPlaceModerator")
  editedPlaces                  Place[]                            @relation("PlaceLastEditor")
  verifiedPlaces                Place[]                            @relation("PlaceVerifier")
  capacityUpdates               AccommodationCapacityGroup[]
  availabilityHistory           AccommodationAvailabilityHistory[]
  createdDrafts                 SubmissionDraft[]                  @relation("DraftCreator")
  updatedDrafts                 SubmissionDraft[]                  @relation("DraftUpdater")
  resolvedImportCandidates      ImportCandidate[]                  @relation("ImportCandidateResolver")
  requiredVerificationContacts  PlaceVerificationContact[]         @relation("VerificationContactRequiredBy")
  completedVerificationContacts PlaceVerificationContact[]         @relation("VerificationContactCompletedBy")
  permissionOverrides           AdminUserPermission[]
  placeAccesses                 UserPlaceAccess[]                  @relation("UserPlaceAccessUser")
  grantedPlaceAccesses          UserPlaceAccess[]                  @relation("UserPlaceAccessCreator")
  accessTokens                  AdminAccessToken[]                 @relation("AdminAccessTokenUser")
  createdAccessTokens           AdminAccessToken[]                 @relation("AdminAccessTokenCreator")
  pushSubscriptions             PushSubscription[]
  importBatches                 ImportBatch[]        @relation("ImportBatchUploader")
  organizationRegistration     OrganizationRegistration?
  reviewedOrganizationRegistrations OrganizationRegistration[] @relation("OrganizationRegistrationReviewer")
  placeAccessRequests           PlaceAccessRequest[] @relation("PlaceAccessRequestUser")
  reviewedPlaceAccessRequests   PlaceAccessRequest[] @relation("PlaceAccessRequestReviewer")
  organizationMemberships       OrganizationMembership[]

  @@index([active])
  @@map("admin_users")
}

model AdminUserPermission {
  id          String                @id @default(uuid()) @db.Uuid
  adminUserId String                @db.Uuid
  permission  AdminPermission
  effect      AdminPermissionEffect
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  adminUser   AdminUser             @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, permission])
  @@index([permission, effect])
  @@map("admin_user_permissions")
}

model UserPlaceAccess {
  id               String            @id @default(uuid()) @db.Uuid
  adminUserId      String            @db.Uuid
  placeId          String            @db.Uuid
  permissions      AdminPermission[]
  active           Boolean           @default(true)
  createdByAdminId String            @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  adminUser        AdminUser         @relation("UserPlaceAccessUser", fields: [adminUserId], references: [id], onDelete: Cascade)
  place            Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdBy        AdminUser         @relation("UserPlaceAccessCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@unique([adminUserId, placeId])
  @@index([placeId, active])
  @@index([adminUserId, active])
  @@map("user_place_access")
}

model OrganizationMembership {
  id             String                      @id @default(uuid()) @db.Uuid
  organizationId String                      @db.Uuid
  adminUserId    String                      @db.Uuid
  status         OrganizationMembershipStatus @default(ACTIVE)
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                    @updatedAt @db.Timestamptz(3)
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adminUser      AdminUser                    @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, adminUserId])
  @@index([adminUserId, status])
  @@map("organization_memberships")
}

model AdminAccessToken {
  id               String            @id @default(uuid()) @db.Uuid
  adminUserId      String            @db.Uuid
  purpose          AdminTokenPurpose
  tokenHash        String            @unique @db.Char(64)
  expiresAt        DateTime          @db.Timestamptz(3)
  usedAt           DateTime?         @db.Timestamptz(3)
  createdByAdminId String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  adminUser        AdminUser         @relation("AdminAccessTokenUser", fields: [adminUserId], references: [id], onDelete: Cascade)
  createdBy        AdminUser?        @relation("AdminAccessTokenCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([adminUserId, purpose, expiresAt])
  @@index([purpose, expiresAt, usedAt])
  @@map("admin_access_tokens")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AuditLog {
  id                String              @id @default(uuid()) @db.Uuid
  adminUserId       String              @db.Uuid
  action            AuditAction
  entityType        AuditEntityType
  entityId          String              @db.Uuid
  previousStatus    ModerationStatus?
  newStatus         ModerationStatus?
  note              String?             @db.VarChar(1000)
  changedFields     String[]            @default([])
  previousValues    Json?
  newValues         Json?
  changeOrigin      ChangeOrigin?
  sourceType        VerificationSource?
  sourceReferenceId String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  adminUser         AdminUser           @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model HelpRequest {
  id               String             @id @default(uuid()) @db.Uuid
  status           HelpRequestStatus  @default(NEW)
  urgency          HelpRequestUrgency @default(UNKNOWN)
  emergencyAnswer  InformationState
  needs            HelpRequestNeed[]
  description      String             @db.VarChar(5000)
  addressText      String?            @db.VarChar(500)
  latitude         Float?
  longitude        Float?
  locationAccuracy Float?
  reporterName     String?            @db.VarChar(160)
  reporterPhone    String?            @db.VarChar(50)
  reporterEmail    String?            @db.VarChar(320)
  anonymous        Boolean            @default(true)
  internalNotes    String?            @db.VarChar(4000)
  reviewedAt       DateTime?          @db.Timestamptz(3)
  resolvedAt       DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([urgency, createdAt])
  @@map("help_requests")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(200)
  name        String   @db.VarChar(250)
  description String?  @db.VarChar(2000)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(320)
  website     String?  @db.VarChar(2048)
  nip         String?  @db.VarChar(10)
  regon       String?  @db.VarChar(14)
  krs         String?  @db.VarChar(10)
  legalForm   String?  @db.VarChar(160)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  places      Place[]
  registrations OrganizationRegistration[]
  possibleRegistrations OrganizationRegistration[] @relation("OrganizationRegistrationPossible")
  accessRequests PlaceAccessRequest[]
  memberships OrganizationMembership[]
  newPlaceSubmissions NewPlaceSubmission[]

  @@index([active, name])
  @@map("organizations")
}

model KnowledgeArticle {
  id                   String                       @id @default(uuid()) @db.Uuid
  title                String                       @db.VarChar(240)
  slug                 String                       @unique @db.VarChar(240)
  excerpt              String                       @db.VarChar(600)
  content              String                       @db.Text
  status               KnowledgeStatus              @default(DRAFT)
  contentType          KnowledgeContentType         @default(GUIDE)
  intent               KnowledgeIntent              @default(NEED_HELP)
  tags                 String[]                     @default([])
  seoTitle             String?                      @db.VarChar(240)
  seoDescription       String?                      @db.VarChar(320)
  authorDisplayName    String?                      @db.VarChar(160)
  readingTime          Int?
  featured             Boolean                      @default(false)
  important            Boolean                      @default(false)
  partnerContent       Boolean                      @default(false)
  partnerName          String?                      @db.VarChar(240)
  partnerDisclosure    String?                      @db.VarChar(500)
  geographicScope      String?                      @db.VarChar(160)
  emergencyNote        String?                      @db.VarChar(500)
  notificationEligible Boolean                      @default(false)
  notificationCategory String?                      @db.VarChar(120)
  publishedAt          DateTime?                    @db.Timestamptz(3)
  reviewedAt           DateTime?                    @db.Timestamptz(3)
  reviewDueAt          DateTime?                    @db.Timestamptz(3)
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)
  categories           KnowledgeArticleCategory[]
  places               KnowledgeArticlePlace[]
  relatedFrom          KnowledgeArticleRelation[]   @relation("KnowledgeRelationFrom")
  relatedTo            KnowledgeArticleRelation[]   @relation("KnowledgeRelationTo")

  @@index([status, featured, publishedAt])
  @@index([intent, status])
  @@map("knowledge_articles")
}

model KnowledgeArticleCategory {
  articleId  String           @db.Uuid
  categoryId String           @db.Uuid
  article    KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@map("knowledge_article_categories")
}

model KnowledgeArticlePlace {
  articleId String           @db.Uuid
  placeId   String           @db.Uuid
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  place     Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([articleId, placeId])
  @@map("knowledge_article_places")
}

model KnowledgeArticleRelation {
  articleId        String           @db.Uuid
  relatedArticleId String           @db.Uuid
  article          KnowledgeArticle @relation("KnowledgeRelationFrom", fields: [articleId], references: [id], onDelete: Cascade)
  relatedArticle   KnowledgeArticle @relation("KnowledgeRelationTo", fields: [relatedArticleId], references: [id], onDelete: Cascade)

  @@id([articleId, relatedArticleId])
  @@map("knowledge_article_relations")
}

model OrganizationRegistration {
  id                    String                        @id @default(uuid()) @db.Uuid
  adminUserId           String                        @unique @db.Uuid
  organizationId        String?                       @db.Uuid
  organizationName      String                        @db.VarChar(250)
  nip                   String?                       @db.VarChar(20)
  website               String?                       @db.VarChar(2048)
  organizationPhone     String?                       @db.VarChar(50)
  organizationEmail     String                        @db.VarChar(320)
  applicantName         String                        @db.VarChar(160)
  applicantEmail        String                        @db.VarChar(320)
  applicantPhone        String?                       @db.VarChar(50)
  applicantPosition     String?                       @db.VarChar(160)
  status                OrganizationRegistrationStatus @default(EMAIL_PENDING)
  possibleOrganizationId String?                      @db.Uuid
  rejectionReason       String?                       @db.VarChar(1000)
  verifiedAt            DateTime?                     @db.Timestamptz(3)
  reviewedByAdminId     String?                       @db.Uuid
  reviewedAt            DateTime?                     @db.Timestamptz(3)
  createdAt             DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                      @updatedAt @db.Timestamptz(3)
  adminUser             AdminUser                     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
