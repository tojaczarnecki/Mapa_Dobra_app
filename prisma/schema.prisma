model PushSubscription {
  id             String                  @id @default(uuid()) @db.Uuid
  endpoint       String                  @unique @db.VarChar(2048)
  p256dh         String                  @db.VarChar(255)
  auth           String                  @db.VarChar(255)
  userAgent      String?                 @db.VarChar(500)
  locale         String?                 @db.VarChar(20)
  region         String?                 @db.VarChar(120)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  lastSeenAt     DateTime                @default(now()) @db.Timestamptz(3)
  adminUserId    String?                 @db.Uuid
  preferences    NotificationPreference?
  deliveries     NotificationDelivery[]
  adminUser      AdminUser?              @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([lastSeenAt])
  @@index([adminUserId])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id             String             @id @default(uuid()) @db.Uuid
  subscriptionId String             @unique @db.Uuid
  localAlerts    Boolean            @default(true)
  savedPlaces    Boolean            @default(true)
  guides         Boolean            @default(true)
  volunteering   Boolean            @default(true)
  partnerContent Boolean            @default(false)
  quietHoursFrom String?            @db.VarChar(5)
  quietHoursTo   String?            @db.VarChar(5)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  subscription   PushSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  subscriptionId String                     @db.Uuid
  category       NotificationCategory
  dedupeKey      String                     @db.VarChar(255)
  status         NotificationDeliveryStatus
  sentAt         DateTime?                  @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  subscription   PushSubscription            @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, dedupeKey])
  @@index([category, createdAt])
  @@map("notification_deliveries")
}

