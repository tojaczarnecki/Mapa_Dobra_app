  moderatedBy            AdminUser?                  @relation("PlaceUpdateModerator", fields: [moderatedByAdminUserId], references: [id], onDelete: SetNull)
  targetPlace            Place?                      @relation("SubmissionTargetPlace", fields: [targetPlaceId], references: [id], onDelete: SetNull)
  publishedPlace         Place?                      @relation("PublishedUpdatePlace", fields: [publishedPlaceId], references: [id], onDelete: SetNull)
  draft                  SubmissionDraft?

  @@index([moderationStatus, createdAt])
  @@index([placeSlug])
  @@index([targetPlaceId])
  @@map("place_update_submissions")
}

model NewPlaceSubmission {
  id                              String                      @id @default(uuid()) @db.Uuid
  requestId                       String                      @unique @db.Uuid
  name                            String                      @db.VarChar(250)
  organizationName                String?                     @db.VarChar(250)
  organizationId                  String?                     @db.Uuid
  categories                      HelpCategory[]
  streetAddress                   String?                     @db.VarChar(300)
  postalCode                      String?                     @db.VarChar(20)
  city                            String                      @db.VarChar(120)
  district                        String?                     @db.VarChar(120)
  proposedLatitude                Float?
  proposedLongitude               Float?
  phone                           String?                     @db.VarChar(50)
  email                           String?                     @db.VarChar(320)
  website                         String?                     @db.VarChar(2048)
  openingHoursDescription         String?                     @db.VarChar(1200)
  description                     String?                     @db.VarChar(4000)
  requirements                    String[]
  sourceType                      SubmissionSourceType?
  sourceUrl                       String?                     @db.VarChar(2048)
  reporterName                    String?                     @db.VarChar(160)
  reporterEmail                   String?                     @db.VarChar(320)
  reporterPhone                   String?                     @db.VarChar(50)
  accommodationType               String?                     @db.VarChar(160)
  targetGroups                    String[]
  availabilityKnown               InformationState?
  availableBedsReported           Int?
  availabilityReportedAt          DateTime?                   @db.Timestamptz(3)
  availabilityReportedDescription String?                     @db.VarChar(240)
  admissionHoursDescription       String?                     @db.VarChar(1200)
  sobrietyPolicy                  String?                     @db.VarChar(240)
  petPolicy                       String?                     @db.VarChar(240)
  accessibilityFeatures           String[]
  moderationStatus                ModerationStatus            @default(PENDING)
  publicationStatus               SubmissionPublicationStatus @default(NOT_PUBLISHED)
  moderatorNote                   String?                     @db.VarChar(2000)
  rejectionReason                 String?                     @db.VarChar(1000)
  moderatedAt                     DateTime?                   @db.Timestamptz(3)
  moderatedByAdminUserId          String?                     @db.Uuid
  publishedPlaceId                String?                     @db.Uuid
  publishedAt                     DateTime?                   @db.Timestamptz(3)
  createdAt                       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime                    @updatedAt @db.Timestamptz(3)
  moderatedBy                     AdminUser?                  @relation("NewPlaceModerator", fields: [moderatedByAdminUserId], references: [id], onDelete: SetNull)
  publishedPlace                  Place?                      @relation("PublishedNewPlace", fields: [publishedPlaceId], references: [id], onDelete: SetNull)
  organization                    Organization?               @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  draft                           SubmissionDraft?

  @@index([moderationStatus, createdAt])
  @@index([publishedPlaceId])
  @@index([organizationId])
  @@map("new_place_submissions")
}
