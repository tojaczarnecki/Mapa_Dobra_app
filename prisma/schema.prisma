generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ModerationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SubmissionPublicationStatus {
  NOT_PUBLISHED
  PUBLISHED
}

enum PlaceUpdateType {
  HOURS                      @map("hours")
  ADDRESS                    @map("address")
  PHONE                      @map("phone")
  ONLINE_CONTACT             @map("online-contact")
  HELP_SCOPE                 @map("help-scope")
  REQUIREMENTS               @map("requirements")
  TEMPORARY_CLOSURE          @map("temporary-closure")
  PERMANENT_CLOSURE          @map("permanent-closure")
  ACCOMMODATION_AVAILABILITY @map("accommodation-availability")
  ACCOMMODATION_RULES        @map("accommodation-rules")
  OTHER                      @map("other")
}

enum HelpCategory {
  FOOD          @map("food")
  ACCOMMODATION @map("accommodation")
  HYGIENE       @map("hygiene")
  CLOTHING      @map("clothing")
  MEDICAL       @map("medical")
  PSYCHOLOGICAL @map("psychological")
  LEGAL         @map("legal")
  SOCIAL        @map("social")
  OTHER         @map("other")
}

enum SubmissionSourceType {
  VISITED        @map("visited")
  USED_HELP      @map("used-help")
  STAFF          @map("staff")
  PHONE          @map("phone")
  WEBSITE        @map("website")
  SOCIAL         @map("social")
  VOLUNTEER      @map("volunteer")
  RECOMMENDATION @map("recommendation")
  OTHER          @map("other")
  PREFER_NOT     @map("prefer-not")
}

enum InformationState {
  YES
  NO
  UNKNOWN
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  PLACE_MANAGER
  VIEWER
}

enum AdminPermission {
  VIEW_DASHBOARD
  VIEW_PLACES
  CREATE_PLACES
  EDIT_PLACES
  VERIFY_PLACES
  PUBLISH_PLACES
  CHANGE_PLACE_STATUS
  UPDATE_BED_AVAILABILITY
  UPDATE_ADMISSION_STATUS
  UPDATE_ADMISSION_HOURS
  UPDATE_PLACE_CONTACT
  UPDATE_PLACE_BASIC
  UPDATE_ACCOMMODATION_DETAILS
  UPDATE_TOTAL_CAPACITY
  MODERATE_SUBMISSIONS
  PUBLISH_SUBMISSIONS
  VIEW_ORGANIZATIONS
  MANAGE_ORGANIZATIONS
  VIEW_CATEGORIES
  MANAGE_CATEGORIES
  VIEW_IMPORTS
  MANAGE_IMPORTS
  VIEW_AUDIT_LOG
  MANAGE_USERS
  MANAGE_USER_PERMISSIONS
}

enum AdminPermissionEffect {
  ALLOW
  DENY
}

enum AdminTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

enum AuditAction {
  LOGIN
  STATUS_CHANGED
  APPROVED
  REJECTED
  PLACE_CREATED
  PLACE_UPDATED
  PLACE_PUBLISHED
  PLACE_STATUS_CHANGED
  AVAILABILITY_UPDATED
  DRAFT_SAVED
  DRAFT_REBASED
  SUBMISSION_PUBLISHED
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_ARCHIVED
  ORGANIZATION_RESTORED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_ACTIVATED
  CATEGORY_DEACTIVATED
  PLACE_IMPORTED
  VERIFICATION_STARTED
  IMPORT_CONFLICT_RESOLVED
  IMPORT_CANDIDATE_SKIPPED
  LOCATION_UPDATED
  PLACE_VERIFIED
  VERIFICATION_CONTACT_REQUIRED
  VERIFICATION_CONTACT_RECORDED
  USER_INVITED
  USER_ACTIVATED
  USER_ROLE_CHANGED
  USER_PERMISSIONS_CHANGED
  USER_PLACE_ACCESS_GRANTED
  USER_PLACE_ACCESS_REVOKED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_SESSIONS_REVOKED
  PASSWORD_RESET_CREATED
  PASSWORD_RESET_COMPLETED
  BED_AVAILABILITY_UPDATED
  ADMISSION_STATUS_UPDATED
  ADMISSION_HOURS_UPDATED
  PLACE_CONTACT_UPDATED
}

enum AuditEntityType {
  ADMIN_USER
  PLACE_UPDATE_SUBMISSION
  NEW_PLACE_SUBMISSION
  PLACE
  ACCOMMODATION_CAPACITY_GROUP
  SUBMISSION_DRAFT
  ORGANIZATION
  CATEGORY
  IMPORT_CANDIDATE
  USER_PLACE_ACCESS
}

enum PlacePublicationStatus {
  DRAFT
  PUBLISHED
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED
  ARCHIVED
}

enum PlaceVerificationStatus {
  UNVERIFIED
  VERIFIED
  NEEDS_CONFIRMATION
}

enum PlaceOperationalStatus {
  OPEN
  CLOSED
  OPEN_TODAY
  UNKNOWN
}

enum PlaceRecordKind {
  PRODUCTION
  DEMO
  TEST
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OpeningHoursKind {
  OPERATION
  ADMISSION
}

enum OpeningHoursStatus {
  OPEN
  CLOSED
  UNKNOWN
}

enum RequirementKind {
  REFERRAL
  DOCUMENT
  FEE
  LODZ_REGISTRATION
  APPOINTMENT
  OTHER
}

enum AccessibilityFeature {
  STEP_FREE_ENTRANCE
  RAMP
  ELEVATOR
  ACCESSIBLE_TOILET
  ACCESSIBLE_SHOWER
  WHEELCHAIR_PLACE
  ASSISTANCE_DOG
  CARE_SERVICES
  STAY_WITH_ASSISTANT
  OTHER
}

enum AccommodationType {
  SHELTER
  NIGHT_SHELTER
  WARMING_CENTER
  HOSTEL
  INTERVENTION_HOSTEL
  CARE_SHELTER
  WOMEN_WITH_CHILDREN_HOME
  OTHER
}

enum AccommodationAvailabilityState {
  AVAILABLE
  FEW
  FULL
  UNKNOWN
  STALE
  SUSPENDED
}

enum SobrietyPolicy {
  SOBRIETY_REQUIRED
  ZERO_TOLERANCE
  INDIVIDUAL_ASSESSMENT
  SEPARATE_PROCEDURE
  UNKNOWN
}

enum PetPolicy {
  ACCEPTED
  NOT_ACCEPTED
  DOG_ONLY
  BY_ARRANGEMENT
  ASSISTANCE_DOG_ONLY
  UNKNOWN
}

enum ChangeOrigin {
  DEMO_MIGRATION
  ADMIN_MANUAL
  USER_SUBMISSION
  SOURCE_IMPORT
  FACILITY_REPRESENTATIVE
}

enum ImportBatchStatus {
  STAGED
  IMPORTED
  COMPLETED_WITH_REVIEW
}

enum ImportCandidateStatus {
  IMPORT_READY
  MATCH_EXISTING
  REQUIRES_REVIEW
  IMPORTED
  SKIPPED
}

enum VerificationQueueStatus {
  PENDING
  IN_PROGRESS
  CONTACT_REQUIRED
  READY
  VERIFIED
  SKIPPED
}

enum ImportCandidateResolution {
  SAME_PLACE
  DIFFERENT_PLACE
  SKIPPED
}

enum PlaceLocationSource {
  GEOCODER
  MANUAL
}

enum VerificationContactReason {
  MISSING_CURRENT_HOURS
  UNCERTAIN_ADDRESS
  OUTDATED_PHONE
  CONFLICTING_SOURCES
  REQUIREMENTS_CONFIRMATION
  POSSIBLY_CLOSED_OR_MOVED
  NO_RELIABLE_ONLINE_SOURCE
  OTHER
}

enum VerificationContactMethod {
  PHONE
  EMAIL
  IN_PERSON
}

enum VerificationSource {
  PHONE_CALL
  ORGANIZATION_EMAIL
  VISIT
  OFFICIAL_WEBSITE
  SOCIAL_MEDIA
  OTHER
}

enum DraftFieldDecision {
  PENDING
  INCLUDE
  REJECT
}

model AdminUser {
  id                            String                             @id @default(uuid()) @db.Uuid
  email                         String                             @unique @db.VarChar(320)
  passwordHash                  String?                            @db.VarChar(512)
  displayName                   String                             @db.VarChar(160)
  role                          AdminRole                          @default(MODERATOR)
  active                        Boolean                            @default(true)
  createdAt                     DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                           @updatedAt @db.Timestamptz(3)
  lastLoginAt                   DateTime?                          @db.Timestamptz(3)
  sessions                      AdminSession[]
  auditLogs                     AuditLog[]
  moderatedPlaceUpdates         PlaceUpdateSubmission[]            @relation("PlaceUpdateModerator")
  moderatedNewPlaceSubmissions  NewPlaceSubmission[]               @relation("NewPlaceModerator")
  editedPlaces                  Place[]                            @relation("PlaceLastEditor")
  verifiedPlaces                Place[]                            @relation("PlaceVerifier")
  capacityUpdates               AccommodationCapacityGroup[]
  availabilityHistory           AccommodationAvailabilityHistory[]
  createdDrafts                 SubmissionDraft[]                  @relation("DraftCreator")
  updatedDrafts                 SubmissionDraft[]                  @relation("DraftUpdater")
  resolvedImportCandidates      ImportCandidate[]                  @relation("ImportCandidateResolver")
  requiredVerificationContacts  PlaceVerificationContact[]         @relation("VerificationContactRequiredBy")
  completedVerificationContacts PlaceVerificationContact[]         @relation("VerificationContactCompletedBy")
  permissionOverrides           AdminUserPermission[]
  placeAccesses                 UserPlaceAccess[]                  @relation("UserPlaceAccessUser")
  grantedPlaceAccesses          UserPlaceAccess[]                  @relation("UserPlaceAccessCreator")
  accessTokens                  AdminAccessToken[]                 @relation("AdminAccessTokenUser")
  createdAccessTokens           AdminAccessToken[]                 @relation("AdminAccessTokenCreator")

  @@index([active])
  @@map("admin_users")
}

model AdminUserPermission {
  id          String                @id @default(uuid()) @db.Uuid
  adminUserId String                @db.Uuid
  permission  AdminPermission
  effect      AdminPermissionEffect
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  adminUser   AdminUser             @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, permission])
  @@index([permission, effect])
  @@map("admin_user_permissions")
}

model UserPlaceAccess {
  id               String            @id @default(uuid()) @db.Uuid
  adminUserId      String            @db.Uuid
  placeId          String            @db.Uuid
  permissions      AdminPermission[]
  active           Boolean           @default(true)
  createdByAdminId String            @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  adminUser        AdminUser         @relation("UserPlaceAccessUser", fields: [adminUserId], references: [id], onDelete: Cascade)
  place            Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdBy        AdminUser         @relation("UserPlaceAccessCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@unique([adminUserId, placeId])
  @@index([placeId, active])
  @@index([adminUserId, active])
  @@map("user_place_access")
}

model AdminAccessToken {
  id               String            @id @default(uuid()) @db.Uuid
  adminUserId      String            @db.Uuid
  purpose          AdminTokenPurpose
  tokenHash        String            @unique @db.Char(64)
  expiresAt        DateTime          @db.Timestamptz(3)
  usedAt           DateTime?         @db.Timestamptz(3)
  createdByAdminId String?           @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  adminUser        AdminUser         @relation("AdminAccessTokenUser", fields: [adminUserId], references: [id], onDelete: Cascade)
  createdBy        AdminUser?        @relation("AdminAccessTokenCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([adminUserId, purpose, expiresAt])
  @@index([purpose, expiresAt, usedAt])
  @@map("admin_access_tokens")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AuditLog {
  id                String              @id @default(uuid()) @db.Uuid
  adminUserId       String              @db.Uuid
  action            AuditAction
  entityType        AuditEntityType
  entityId          String              @db.Uuid
  previousStatus    ModerationStatus?
  newStatus         ModerationStatus?
  note              String?             @db.VarChar(1000)
  changedFields     String[]            @default([])
  previousValues    Json?
  newValues         Json?
  changeOrigin      ChangeOrigin?
  sourceType        VerificationSource?
  sourceReferenceId String?             @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  adminUser         AdminUser           @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(200)
  name        String   @db.VarChar(250)
  description String?  @db.VarChar(2000)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(320)
  website     String?  @db.VarChar(2048)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  places      Place[]

  @@index([active, name])
  @@map("organizations")
}

model Category {
  id            String          @id @default(uuid()) @db.Uuid
  slug          String          @unique @db.VarChar(120)
  name          String          @db.VarChar(160)
  description   String?         @db.VarChar(1000)
  active        Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  placeLinks    PlaceCategory[]
  primaryPlaces Place[]         @relation("PrimaryPlaceCategory")

  @@index([active, sortOrder])
  @@map("categories")
}

model Place {
  id                      String                    @id @default(uuid()) @db.Uuid
  legacyId                String?                   @unique @db.VarChar(200)
  citySlug                String                    @default("lodz") @db.VarChar(120)
  slug                    String                    @unique @db.VarChar(200)
  name                    String                    @db.VarChar(250)
  organizationId          String?                   @db.Uuid
  primaryCategoryId       String                    @db.Uuid
  typeLabel               String?                   @db.VarChar(160)
  description             String?                   @db.VarChar(4000)
  street                  String?                   @db.VarChar(300)
  buildingNumber          String?                   @db.VarChar(40)
  addressLine             String                    @db.VarChar(400)
  postalCode              String?                   @db.VarChar(20)
  city                    String                    @default("Łódź") @db.VarChar(120)
  district                String?                   @db.VarChar(120)
  latitude                Decimal?                  @db.Decimal(9, 6)
  longitude               Decimal?                  @db.Decimal(9, 6)
  locationSource          PlaceLocationSource?
  locationUpdatedAt       DateTime?                 @db.Timestamptz(3)
  phone                   String?                   @db.VarChar(50)
  email                   String?                   @db.VarChar(320)
  website                 String?                   @db.VarChar(2048)
  socialMedia             String?                   @db.VarChar(2048)
  publicationStatus       PlacePublicationStatus    @default(DRAFT)
  verificationStatus      PlaceVerificationStatus   @default(UNVERIFIED)
  operationalStatus       PlaceOperationalStatus    @default(UNKNOWN)
  todayHoursLabel         String?                   @db.VarChar(240)
  verificationNote        String?                   @db.VarChar(1000)
  verificationSource      VerificationSource?
  verificationSourceUrl   String?                   @db.VarChar(2048)
  verifiedAt              DateTime?                 @db.Timestamptz(3)
  verifiedByAdminUserId   String?                   @db.Uuid
  internalNote            String?                   @db.VarChar(2000)
  audience                String[]
  services                String[]
  distanceLabel           String?                   @db.VarChar(80)
  recordKind              PlaceRecordKind           @default(PRODUCTION)
  verificationQueueStatus VerificationQueueStatus?
  isDemo                  Boolean                   @default(false)
  lastEditedByAdminUserId String?                   @db.Uuid
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)
  organization            Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  primaryCategory         Category                  @relation("PrimaryPlaceCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  categories              PlaceCategory[]
  openingHours            OpeningHours[]
  requirements            PlaceRequirement[]
  accessibility           PlaceAccessibility[]
  accommodation           AccommodationDetails?
  lastEditedBy            AdminUser?                @relation("PlaceLastEditor", fields: [lastEditedByAdminUserId], references: [id], onDelete: SetNull)
  verifiedBy              AdminUser?                @relation("PlaceVerifier", fields: [verifiedByAdminUserId], references: [id], onDelete: SetNull)
  updateSubmissions       PlaceUpdateSubmission[]   @relation("SubmissionTargetPlace")
  publishedUpdates        PlaceUpdateSubmission[]   @relation("PublishedUpdatePlace")
  publishedNewPlaces      NewPlaceSubmission[]      @relation("PublishedNewPlace")
  submissionDrafts        SubmissionDraft[]
  createdFromImport       ImportCandidate?          @relation("CreatedImportPlace")
  importMatchCandidates   ImportCandidate[]         @relation("MatchedImportPlace")
  verificationContact     PlaceVerificationContact?
  userAccesses            UserPlaceAccess[]

  @@index([recordKind, publicationStatus, city])
  @@index([verificationQueueStatus, recordKind, publicationStatus])
  @@index([primaryCategoryId])
  @@index([name])
  @@map("places")
}

model PlaceVerificationContact {
  id                     String                      @id @default(uuid()) @db.Uuid
  placeId                String                      @unique @db.Uuid
  reasons                VerificationContactReason[]
  requiredNote           String?                     @db.VarChar(1000)
  requiredAt             DateTime                    @default(now()) @db.Timestamptz(3)
  requiredByAdminUserId  String                      @db.Uuid
  contactedAt            DateTime?                   @db.Timestamptz(3)
  contactMethod          VerificationContactMethod?
  contactResult          String?                     @db.VarChar(2000)
  contactedByAdminUserId String?                     @db.Uuid
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(3)
  place                  Place                       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  requiredByAdminUser    AdminUser                   @relation("VerificationContactRequiredBy", fields: [requiredByAdminUserId], references: [id], onDelete: Restrict)
  contactedByAdminUser   AdminUser?                  @relation("VerificationContactCompletedBy", fields: [contactedByAdminUserId], references: [id], onDelete: SetNull)

  @@index([contactedAt, requiredAt])
  @@map("place_verification_contacts")
}

model ImportBatch {
  id                 String              @id @default(uuid()) @db.Uuid
  key                String              @unique @db.VarChar(160)
  title              String              @db.VarChar(500)
  sourceUrl          String              @db.VarChar(2048)
  publisher          String              @db.VarChar(250)
  edition            String              @db.VarChar(80)
  sourceDocumentHash String              @db.Char(64)
  importedAt         DateTime?           @db.Timestamptz(3)
  importDate         DateTime            @db.Date
  status             ImportBatchStatus   @default(STAGED)
  rawEntryCount      Int                 @default(0)
  candidateCount     Int                 @default(0)
  importedCount      Int                 @default(0)
  matchedCount       Int                 @default(0)
  reviewCount        Int                 @default(0)
  skippedCount       Int                 @default(0)
  metadata           Json?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  sourceEntries      ImportSourceEntry[]
  candidates         ImportCandidate[]

  @@index([status, createdAt])
  @@map("import_batches")
}

model ImportSourceEntry {
  id                       String                  @id @default(uuid()) @db.Uuid
  importBatchId            String                  @db.Uuid
  sourceKey                String                  @db.VarChar(200)
  section                  String                  @db.VarChar(200)
  sourcePages              Int[]
  rawName                  String                  @db.VarChar(500)
  rawAddress               String?                 @db.VarChar(1200)
  rawPhone                 String?                 @db.VarChar(500)
  rawEmail                 String?                 @db.VarChar(500)
  rawWebsite               String?                 @db.VarChar(2048)
  rawOpeningHours          String?                 @db.VarChar(2000)
  rawAdmissionHours        String?                 @db.VarChar(2000)
  rawAssistanceDescription String?                 @db.VarChar(5000)
  rawText                  String                  @db.Text
  parsedData               Json?
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  importBatch              ImportBatch             @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  candidates               ImportCandidateSource[]

  @@unique([importBatchId, sourceKey])
  @@index([importBatchId, section])
  @@map("import_source_entries")
}

model ImportCandidate {
  id                       String                     @id @default(uuid()) @db.Uuid
  importBatchId            String                     @db.Uuid
  candidateKey             String                     @db.VarChar(200)
  status                   ImportCandidateStatus
  proposedName             String                     @db.VarChar(500)
  proposedAddress          String?                    @db.VarChar(1200)
  proposedPhone            String?                    @db.VarChar(500)
  proposedEmail            String?                    @db.VarChar(500)
  proposedWebsite          String?                    @db.VarChar(2048)
  proposedOrganizationName String?                    @db.VarChar(500)
  categorySlugs            String[]
  primaryCategorySlug      String?                    @db.VarChar(120)
  reviewReasons            String[]
  proposedData             Json
  matchedPlaceId           String?                    @db.Uuid
  createdPlaceId           String?                    @unique @db.Uuid
  queueStatus              VerificationQueueStatus?
  resolution               ImportCandidateResolution?
  resolvedAt               DateTime?                  @db.Timestamptz(3)
  resolvedByAdminUserId    String?                    @db.Uuid
  resolutionNote           String?                    @db.VarChar(1000)
  createdAt                DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @db.Timestamptz(3)
  importBatch              ImportBatch                @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  matchedPlace             Place?                     @relation("MatchedImportPlace", fields: [matchedPlaceId], references: [id], onDelete: SetNull)
  createdPlace             Place?                     @relation("CreatedImportPlace", fields: [createdPlaceId], references: [id], onDelete: SetNull)
  resolvedBy               AdminUser?                 @relation("ImportCandidateResolver", fields: [resolvedByAdminUserId], references: [id], onDelete: SetNull)
  sources                  ImportCandidateSource[]

  @@unique([importBatchId, candidateKey])
  @@index([importBatchId, status])
  @@index([matchedPlaceId])
  @@index([queueStatus, status])
  @@map("import_candidates")
}

model GeocodingCache {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(80)
  normalizedQuery String   @db.VarChar(700)
  query           String   @db.VarChar(700)
  results         Json
  fetchedAt       DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([provider, normalizedQuery])
  @@index([fetchedAt])
  @@map("geocoding_cache")
}

model ImportCandidateSource {
  importCandidateId String            @db.Uuid
  sourceEntryId     String            @db.Uuid
  importCandidate   ImportCandidate   @relation(fields: [importCandidateId], references: [id], onDelete: Cascade)
  sourceEntry       ImportSourceEntry @relation(fields: [sourceEntryId], references: [id], onDelete: Cascade)

  @@id([importCandidateId, sourceEntryId])
  @@index([sourceEntryId])
  @@map("import_candidate_sources")
}

model PlaceCategory {
  placeId    String   @db.Uuid
  categoryId String   @db.Uuid
  sortOrder  Int      @default(0)
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([placeId, categoryId])
  @@index([categoryId])
  @@map("place_categories")
}

model OpeningHours {
  id        String             @id @default(uuid()) @db.Uuid
  placeId   String             @db.Uuid
  kind      OpeningHoursKind   @default(OPERATION)
  weekday   Weekday
  status    OpeningHoursStatus
  opensAt   String?            @db.VarChar(5)
  closesAt  String?            @db.VarChar(5)
  note      String?            @db.VarChar(240)
  sortOrder Int                @default(0)
  place     Place              @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, kind, weekday, sortOrder])
  @@index([placeId, kind, weekday])
  @@map("opening_hours")
}

model PlaceRequirement {
  id        String           @id @default(uuid()) @db.Uuid
  placeId   String           @db.Uuid
  kind      RequirementKind
  state     InformationState @default(UNKNOWN)
  label     String           @db.VarChar(240)
  note      String?          @db.VarChar(500)
  sortOrder Int              @default(0)
  place     Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, kind, sortOrder])
  @@index([placeId, sortOrder])
  @@map("place_requirements")
}

model PlaceAccessibility {
  id        String               @id @default(uuid()) @db.Uuid
  placeId   String               @db.Uuid
  feature   AccessibilityFeature
  state     InformationState     @default(UNKNOWN)
  label     String               @db.VarChar(240)
  note      String?              @db.VarChar(500)
  sortOrder Int                  @default(0)
  place     Place                @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, feature, sortOrder])
  @@index([placeId, sortOrder])
  @@map("place_accessibility")
}

model AccommodationDetails {
  id                        String                             @id @default(uuid()) @db.Uuid
  placeId                   String                             @unique @db.Uuid
  type                      AccommodationType
  audienceLabel             String?                            @db.VarChar(240)
  targetGroups              String[]
  acceptedProfiles          String[]
  admissionHoursDescription String?                            @db.VarChar(1200)
  acceptsToday              InformationState                   @default(UNKNOWN)
  lodzRegistrationRequired  InformationState                   @default(UNKNOWN)
  referralRequired          InformationState                   @default(UNKNOWN)
  documentRequired          InformationState                   @default(UNKNOWN)
  sobrietyPolicy            SobrietyPolicy                     @default(UNKNOWN)
  sobrietyNote              String?                            @db.VarChar(500)
  petPolicy                 PetPolicy                          @default(UNKNOWN)
  petNote                   String?                            @db.VarChar(500)
  wheelchairAccessibility   InformationState                   @default(UNKNOWN)
  careServices              InformationState                   @default(UNKNOWN)
  partialDependencySupport  InformationState                   @default(UNKNOWN)
  mealsInfo                 String?                            @db.VarChar(500)
  hygieneInfo               String?                            @db.VarChar(500)
  luggageInfo               String?                            @db.VarChar(500)
  returnTimeInfo            String?                            @db.VarChar(500)
  maxStayInfo               String?                            @db.VarChar(500)
  feeInfo                   String?                            @db.VarChar(500)
  availabilityState         AccommodationAvailabilityState     @default(UNKNOWN)
  availabilityLabel         String?                            @db.VarChar(240)
  availabilityConfirmedAt   DateTime?                          @db.Timestamptz(3)
  availabilityNote          String?                            @db.VarChar(1000)
  importantNote             String?                            @db.VarChar(500)
  createdAt                 DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                           @updatedAt @db.Timestamptz(3)
  place                     Place                              @relation(fields: [placeId], references: [id], onDelete: Cascade)
  capacityGroups            AccommodationCapacityGroup[]
  availabilityHistory       AccommodationAvailabilityHistory[]

  @@map("accommodation_details")
}

model AccommodationCapacityGroup {
  id                     String                             @id @default(uuid()) @db.Uuid
  accommodationDetailsId String                             @db.Uuid
  label                  String                             @db.VarChar(160)
  totalBeds              Int?
  availableBeds          Int?
  active                 Boolean                            @default(true)
  availabilityUpdatedAt  DateTime?                          @db.Timestamptz(3)
  updatedByAdminUserId   String?                            @db.Uuid
  sortOrder              Int                                @default(0)
  createdAt              DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                           @updatedAt @db.Timestamptz(3)
  accommodationDetails   AccommodationDetails               @relation(fields: [accommodationDetailsId], references: [id], onDelete: Cascade)
  updatedByAdminUser     AdminUser?                         @relation(fields: [updatedByAdminUserId], references: [id], onDelete: SetNull)
  history                AccommodationAvailabilityHistory[]

  @@unique([accommodationDetailsId, label])
  @@index([accommodationDetailsId, sortOrder])
  @@map("accommodation_capacity_groups")
}

model AccommodationAvailabilityHistory {
  id                     String                         @id @default(uuid()) @db.Uuid
  accommodationDetailsId String                         @db.Uuid
  capacityGroupId        String?                        @db.Uuid
  availabilityState      AccommodationAvailabilityState
  availableBeds          Int?
  totalBeds              Int?
  reportedAt             DateTime                       @db.Timestamptz(3)
  adminUserId            String?                        @db.Uuid
  origin                 ChangeOrigin
  note                   String?                        @db.VarChar(1000)
  createdAt              DateTime                       @default(now()) @db.Timestamptz(3)
  accommodationDetails   AccommodationDetails           @relation(fields: [accommodationDetailsId], references: [id], onDelete: Cascade)
  capacityGroup          AccommodationCapacityGroup?    @relation(fields: [capacityGroupId], references: [id], onDelete: SetNull)
  adminUser              AdminUser?                     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([accommodationDetailsId, reportedAt])
  @@index([capacityGroupId, reportedAt])
  @@map("accommodation_availability_history")
}

model SubmissionDraft {
  id                      String                 @id @default(uuid()) @db.Uuid
  placeUpdateSubmissionId String?                @unique @db.Uuid
  newPlaceSubmissionId    String?                @unique @db.Uuid
  targetPlaceId           String?                @db.Uuid
  createdByAdminUserId    String                 @db.Uuid
  updatedByAdminUserId    String                 @db.Uuid
  basePlaceUpdatedAt      DateTime?              @db.Timestamptz(3)
  basePlaceSnapshot       Json?
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(3)
  placeUpdateSubmission   PlaceUpdateSubmission? @relation(fields: [placeUpdateSubmissionId], references: [id], onDelete: Cascade)
  newPlaceSubmission      NewPlaceSubmission?    @relation(fields: [newPlaceSubmissionId], references: [id], onDelete: Cascade)
  targetPlace             Place?                 @relation(fields: [targetPlaceId], references: [id], onDelete: SetNull)
  createdBy               AdminUser              @relation("DraftCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  updatedBy               AdminUser              @relation("DraftUpdater", fields: [updatedByAdminUserId], references: [id], onDelete: Restrict)
  items                   SubmissionDraftItem[]

  @@index([targetPlaceId])
  @@map("submission_drafts")
}

model SubmissionDraftItem {
  id                   String             @id @default(uuid()) @db.Uuid
  submissionDraftId    String             @db.Uuid
  fieldKey             String             @db.VarChar(120)
  label                String             @db.VarChar(160)
  currentValueSnapshot Json?
  userValueSnapshot    Json?
  workingValue         Json?
  decision             DraftFieldDecision @default(PENDING)
  sortOrder            Int                @default(0)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  submissionDraft      SubmissionDraft    @relation(fields: [submissionDraftId], references: [id], onDelete: Cascade)

  @@unique([submissionDraftId, fieldKey])
  @@index([submissionDraftId, sortOrder])
  @@map("submission_draft_items")
}

model PlaceUpdateSubmission {
  id                     String                      @id @default(uuid()) @db.Uuid
  requestId              String                      @unique @db.Uuid
  placeId                String?                     @db.VarChar(200)
  placeSlug              String?                     @db.VarChar(200)
  placeNameSnapshot      String                      @db.VarChar(250)
  submissionTypes        PlaceUpdateType[]
  description            String                      @db.VarChar(4000)
  proposedPhone          String?                     @db.VarChar(50)
  proposedAddress        String?                     @db.VarChar(400)
  proposedOpeningHours   String?                     @db.VarChar(1200)
  proposedWebsite        String?                     @db.VarChar(2048)
  proposedOtherValue     String?                     @db.VarChar(2000)
  sourceType             SubmissionSourceType?
  sourceUrl              String?                     @db.VarChar(2048)
  reporterName           String?                     @db.VarChar(160)
  reporterEmail          String?                     @db.VarChar(320)
  reporterPhone          String?                     @db.VarChar(50)
  moderationStatus       ModerationStatus            @default(PENDING)
  publicationStatus      SubmissionPublicationStatus @default(NOT_PUBLISHED)
  moderatorNote          String?                     @db.VarChar(2000)
  rejectionReason        String?                     @db.VarChar(1000)
  moderatedAt            DateTime?                   @db.Timestamptz(3)
  moderatedByAdminUserId String?                     @db.Uuid
  targetPlaceId          String?                     @db.Uuid
  publishedPlaceId       String?                     @db.Uuid
  publishedAt            DateTime?                   @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(3)
  moderatedBy            AdminUser?                  @relation("PlaceUpdateModerator", fields: [moderatedByAdminUserId], references: [id], onDelete: SetNull)
  targetPlace            Place?                      @relation("SubmissionTargetPlace", fields: [targetPlaceId], references: [id], onDelete: SetNull)
  publishedPlace         Place?                      @relation("PublishedUpdatePlace", fields: [publishedPlaceId], references: [id], onDelete: SetNull)
  draft                  SubmissionDraft?

  @@index([moderationStatus, createdAt])
  @@index([placeSlug])
  @@index([targetPlaceId])
  @@map("place_update_submissions")
}

model NewPlaceSubmission {
  id                              String                      @id @default(uuid()) @db.Uuid
  requestId                       String                      @unique @db.Uuid
  name                            String                      @db.VarChar(250)
  organizationName                String?                     @db.VarChar(250)
  categories                      HelpCategory[]
